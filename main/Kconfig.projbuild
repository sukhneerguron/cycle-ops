menu "Cycle-Ops Hardware Configuration"

config I2C_SDA
    int "I2C SDA Pin"
    default 7

config I2C_SCL
    int "I2C SCL Pin"
    default 6

config SPI_MOSI
    int "SPI MOSI Pin"
    default 13

config SPI_SCLK
    int "SPI SCLK Pin"
    default 12

config DISPLAY_CS
    int "Display CS Pin"
    default 11

config DISPLAY_DC
    int "Display DC Pin"
    default 10

config DISPLAY_RST
    int "Display Reset Pin"
    default 9

config DISPLAY_BL
    int "Display Backlight Pin"
    default 8

config DISPLAY_WIDTH
    int "Display Width"
    default 240

config DISPLAY_HEIGHT
    int "Display Height"
    default 320

config TOUCH_INT
    int "Touch Interrupt Pin"
    default 5

config TOUCH_RST
    int "Touch Reset Pin"
    default 4

endmenu
